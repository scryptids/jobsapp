NODE_ENV="development"
# Comma-separated, newest first; older entries still verify existing cookies.
COOKIE_SECRETS="snickerdoodle"

# Development only: /login signs in as seeded user 1 without credentials.
# Set to "false" to use the real email/password login (dev@example.com / password).
DEV_AUTOLOGIN="true"

# SQLite file for local runs (created, migrated and seeded by `npm run dev`).
DATABASE_PATH="./data/dev.db"
