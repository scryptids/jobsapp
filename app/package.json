{
  "name": "jobsapp",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "react-router build && npm run build:server",
    "dev": "react-router dev",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "start": "node --enable-source-maps build/server.js",
    "typecheck": "react-router typegen && tsc",
    "test": "vitest",
    "smoke": "bash ./tools/smoke.sh",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=build/server.js && esbuild src/ops/cli.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=build/ops.js",
    "predev": "npm run db:seed",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx src/db/seed.ts",
    "ops": "tsx src/ops/cli.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@mantine/core": "^8.0.1",
    "@mantine/hooks": "^8.0.1",
    "@react-router/express": "^8.5.1",
    "@react-router/fs-routes": "^8.5.1",
    "@react-router/node": "^8.5.1",
    "@tabler/icons-react": "^3.11.0",
    "@tanstack/react-form-remix": "^1.26.0",
    "@tanstack/react-table": "^8.19.3",
    "better-sqlite3": "^13.2.0",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "globals": "^16.5.0",
    "isbot": "^5.1.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "xstate": "^5.13.1"
  },
  "devDependencies": {
    "@react-router/dev": "^8.5.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "postcss": "^8.4.38",
    "postcss-preset-mantine": "^1.15.0",
    "postcss-simple-vars": "^7.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.8",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "better-sqlite3@13.2.0": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents": false
  }
}
