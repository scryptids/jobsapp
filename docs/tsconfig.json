{
  // This file is not used in compilation. It is here just for a nice editor experience.
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    // baseUrl is deprecated in TypeScript 6. Unset the one inherited from
    // @docusaurus/tsconfig; `paths` resolves relative to this file instead.
    "baseUrl": null,
    "paths": {
      "@site/*": ["./*"]
    }
  }
}
