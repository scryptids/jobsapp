NODE_ENV="development"
COOKIE_SECRET="snickerdoodle"

# Development only: /login signs in as seeded user 1 without credentials.
# Set to "false" to use the real email/password login locally.
DEV_AUTOLOGIN="true"

GRAPHQL_API_URL="http://localhost:8080/v1/graphql"
HASURA_GRAPHQL_ADMIN_SECRET="bonk"

HASURA_GRAPHQL_JWT_SECRET_KEY="this-is-a-generic-HS256-secret-key-and-you-should-definitely-change-it" # used by Remix
HASURA_GRAPHQL_JWT_SECRET='{"type":"HS256", "key": "this-is-a-generic-HS256-secret-key-and-you-should-definitely-change-it"}' # Hasura expects this to be a stringified JSON object
