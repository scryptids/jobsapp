{
  "name": "www",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "codegen-compile": "node -r dotenv/config node_modules/.bin/gql-gen",
    "codegen-watch": "node -r dotenv/config node_modules/.bin/gql-gen -w",
    "prestart": "npm run codegen-compile",
    "predev": "npm run codegen-compile",
    "test": "vitest",
    "gen-hasura-jwt": "ts-node --project tsconfig.alt.json -r tsconfig-paths/register \"./tools/gen-hasura-jwt.js\"",
    "gen-v4-uuid": "ts-node --project tsconfig.alt.json -r tsconfig-paths/register \"./tools/gen-v4-uuid.js\""
  },
  "dependencies": {
    "@mantine/core": "^8.0.1",
    "@mantine/hooks": "^8.0.1",
    "@react-router/fs-routes": "^8.5.1",
    "@react-router/node": "^8.5.1",
    "@react-router/serve": "^8.5.1",
    "@tabler/icons-react": "^3.11.0",
    "@tanstack/react-form-remix": "^1.26.0",
    "@tanstack/react-table": "^8.19.3",
    "dotenv": "^16.4.5",
    "globals": "^16.5.0",
    "graphql": "^16.8.1",
    "graphql-request": "^6.1.0",
    "isbot": "^5.1.28",
    "jose": "^6.0.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "uuid": "^11.1.0",
    "xstate": "^5.13.1"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^8.0.0",
    "@graphql-codegen/typescript": "^7.0.1",
    "@graphql-codegen/typescript-graphql-request": "^8.0.2",
    "@graphql-codegen/typescript-operations": "^7.0.1",
    "@react-router/dev": "^8.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "postcss": "^8.4.38",
    "postcss-preset-mantine": "^1.15.0",
    "postcss-simple-vars": "^7.0.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.8",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
